{
  "name": "lurkline",
  "version": "0.12.0",
  "transport": {
    "type": "stdio",
    "command": "lurkline",
    "args": [
      "mcp"
    ]
  },
  "policy": "read-only-by-default",
  "required_env": [],
  "optional_env": [
    "LURKLINE_PROFILE",
    "SLACK_BASE_URL",
    "SLACK_TEAM_ID",
    "SLACK_TOKEN",
    "SLACK_COOKIE",
    "LURKLINE_TIMEOUT_MS",
    "LURKLINE_MAX_RESPONSE_BYTES"
  ]
}
